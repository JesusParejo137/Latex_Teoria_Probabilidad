       RowBox[{"k", ",", "0", ",", "10"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ejeX", "=", 
