 RowBox[{
  RowBox[{
   RowBox[{"etiquetasEjeX", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"k", "==", "0"}], ",", "\"\<0\>\"", ",", 
