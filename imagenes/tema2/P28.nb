Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"digitosPermitidos", "=", 
    RowBox[{"{", 
     RowBox[{
     "0", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "7", ",", 
      "8", ",", "9"}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "todas", " ", "las", " ", "cifras", " ", "salvo", " ", "el", " ", "1"}], 
   "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"generarIntervalos", "[", "0", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"generarIntervalos", "[", "n_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"combinaciones", "=", 
        RowBox[{"Tuples", "[", 
         RowBox[{"digitosPermitidos", ",", "n"}], "]"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"digitos", ",", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"inicio", "=", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"digitos", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "i"}]}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"inicio", ",", 
             RowBox[{"inicio", "+", 
              RowBox[{"10", "^", 
               RowBox[{"-", "n"}]}]}]}], "}"}]}], "]"}]}], "]"}], "/@", 
       "combinaciones"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nMax", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sep", "=", "0.075"}], ";"}], "    ", 
  RowBox[{"(*", 
   RowBox[{
   "separaci\[OAcute]n", " ", "vertical", " ", "entre", " ", "A_n", " ", 
    "consecutivos"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"axisY", "=", "0.1"}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"altura", " ", "de", " ", "la", " ", "recta", " ", 
    RowBox[{"real", ":", 
     RowBox[{"ahora", " ", "pegada", " ", "a", " ", "A_", "0"}]}]}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"colores", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RGBColor", "[", 
      RowBox[{"0.8", ",", "0.88", ",", "1"}], "]"}], ",", 
