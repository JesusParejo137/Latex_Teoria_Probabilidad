   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"generarIntervalos", "[", "n_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"combinaciones", "=", 
        RowBox[{"Tuples", "[", 
         RowBox[{"digitosPermitidos", ",", "n"}], "]"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"digitos", ",", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"inicio", "=", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"digitos", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "i"}]}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"inicio", ",", 
             RowBox[{"inicio", "+", 
              RowBox[{"10", "^", 
               RowBox[{"-", "n"}]}]}]}], "}"}]}], "]"}]}], "]"}], "/@", 
       "combinaciones"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"nMax", "=", "2"}], ";"}], "\n", 
 RowBox[{
