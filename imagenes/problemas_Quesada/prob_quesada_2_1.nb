     RowBox[{"RGBColor", "[", 
      RowBox[{"0.1", ",", "0.3", ",", "0.75"}], "]"}]}], ";"}], "    ", 
   RowBox[{"(*", "A", "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"PA", "=", 
     RowBox[{"Total", "[", 
      RowBox[{"an", " ", "pn"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"P", 
       RowBox[{"(", "A", ")"}]}], "=", 
      RowBox[{"suma", " ", "a_n", " ", "P_n", 
       RowBox[{"(", "A", ")"}]}]}], ",", 
     RowBox[{"calculado", " ", "autom\[AAcute]ticamente"}]}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"subDigit", "[", "d_Integer", "]"}], ":=", 
     RowBox[{"FromCharacterCode", "[", 
      RowBox[{"8320", "+", "d"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
