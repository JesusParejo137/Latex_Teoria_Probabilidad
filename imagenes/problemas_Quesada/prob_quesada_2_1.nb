   RowBox[{"(*", 
    RowBox[{"valores", " ", "P_n", 
     RowBox[{"(", "A", ")"}], " ", "para", " ", "el", " ", "mismo", " ", 
     "suceso", " ", "A"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"nTerm", "=", 
     RowBox[{"Length", "[", "an", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"escala", "=", "1.4"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "tama\[NTilde]o", " ", "global", " ", "de", " ", "los", " ", "discos"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"radios", "=", 
     RowBox[{"escala", " ", 
      RowBox[{"Sqrt", "[", "an", "]"}]}]}], ";"}], "           ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"radio", " ", "proporcional", " ", "a", " ", "sqrt", 
      RowBox[{"(", "a_n", ")"}]}], ":", 
     RowBox[{"area", "~", "a_n"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"radioFinal", "=", 
     RowBox[{"escala", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Total", "[", "an", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"colorFondo", "=", 
     RowBox[{"RGBColor", "[", 
      RowBox[{"0.85", ",", "0.9", ",", "1"}], "]"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"Omega", "\\", " ", "A"}], "*)"}], "\n", 
   RowBox[{
