      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"centrosX", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "=", 
